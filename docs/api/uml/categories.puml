title MangoDB API: Categories

class "MangoDB API" as API <<Application>> {
  basePath = "/"
}
class "Categories" as Categories <<Resource>> {
  + GET()
}
class "Category" as CategoryRep <<Representation>> {
  -categoryId : integer
  -categoryName : string
}

API -[#B45309,dashed]-> Categories : <i><color:#B45309>«Path» /categories</color></i>
Categories -[#BE185D,dashed]-> CategoryRep : <i><color:#BE185D>«use»</color></i>
@enduml
