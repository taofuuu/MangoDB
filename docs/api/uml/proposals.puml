@startuml
left to right direction
skinparam classAttributeIconSize 0
hide circle
hide empty members
skinparam shadowing false
skinparam roundcorner 10
skinparam ClassFontStyle bold
skinparam ClassAttributeFontStyle plain
skinparam ArrowFontSize 11
skinparam class {
  BackgroundColor<<Application>> #E8EDF2
  BorderColor<<Application>> #475569
  BackgroundColor<<Resource>> #DDEFEF
  BorderColor<<Resource>> #0F766E
  BackgroundColor<<Representation>> #FCE4F0
  BorderColor<<Representation>> #BE185D
  StereotypeFontColor<<Application>> #475569
  StereotypeFontColor<<Resource>> #0F766E
  StereotypeFontColor<<Representation>> #BE185D
}
title MangoDB API: Proposals

class "MangoDB API" as API <<Application>> {
  basePath = "/"
}
class "Proposals" as Proposals <<Resource>>
class "MyProposals" as MyProposals <<Resource>> {
  + GET()
}
class "Counts" as Counts <<Resource>> {
  + GET()
}
class "Proposal" as ProposalR <<Resource>>
class "Accept" as Accept <<Resource>> {
  + POST()
}
class "Reject" as Reject <<Resource>> {
  + POST()
}
class "SentProposal" as SentProposalRep <<Representation>> {
  -Proposal fields
  -listingTitle : string
  -listingType : JOB, SERVICE
  -recipient : CompanyBrief
  -projectId : integer?
}
class "ProposalStatusCounts" as ProposalStatusCountsRep <<Representation>> {
  -total : integer
  -PENDING : integer
  -ACCEPTED : integer
  -REJECTED : integer
}
class "Project" as ProjectRep <<Representation>> {
  -projectId : integer
  -proposalId : integer
  -totalBudget : number
  -startDate : date
  -projectStatus : ProjectStatus
  -depositReportedAt : date?
  -depositConfirmedAt : date?
  -completedAt : date?
}

API -[#B45309,dashed]-> Proposals : <i><color:#B45309>«Path» /proposals</color></i>
Proposals -[#B45309,dashed]-> MyProposals : <i><color:#B45309>«Path» /mine</color></i>
MyProposals -[#BE185D,dashed]-> SentProposalRep : <i><color:#BE185D>«use»</color></i>
MyProposals -[#B45309,dashed]-> Counts : <i><color:#B45309>«Path» /counts</color></i>
Counts -[#BE185D,dashed]-> ProposalStatusCountsRep : <i><color:#BE185D>«use»</color></i>
Proposals -[#B45309,dashed]-> ProposalR : <i><color:#B45309>«Path» /{proposalId}</color></i>
ProposalR -[#B45309,dashed]-> Accept : <i><color:#B45309>«Path» /accept</color></i>
Accept -[#BE185D,dashed]-> ProjectRep : <i><color:#BE185D>«use»</color></i>
ProposalR -[#B45309,dashed]-> Reject : <i><color:#B45309>«Path» /reject</color></i>
@enduml
