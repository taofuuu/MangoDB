title MangoDB API: Health

class "MangoDB API" as API <<Application>> {
  basePath = "/"
}
class "Health" as HealthR <<Resource>> {
  + GET()
}
class "Health" as HealthRep <<Representation>> {
  -status : ok
}

API -[#B45309,dashed]-> HealthR : <i><color:#B45309>«Path» /health</color></i>
HealthR -[#BE185D,dashed]-> HealthRep : <i><color:#BE185D>«use»</color></i>
