{
    "name": "mangodb",
    "version": "1.0.0",
    "description": "MangoDB",
    "homepage": "https://github.com/taofuuu/MangoDB#readme",
    "bugs": {
        "url": "https://github.com/taofuuu/MangoDB/issues"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/taofuuu/MangoDB.git"
    },
    "license": "ISC",
    "author": "",
    "type": "commonjs",
    "main": "server.js",
    "workspaces": [
        "apps/*",
        "packages/*"
    ],
    "scripts": {
        "prepare": "husky",
        "lint": "npm run lint --workspaces --if-present",
        "typecheck": "npm run typecheck --workspaces --if-present",
        "build": "npm run build --workspaces --if-present",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "verify": "npm run format:check && npm run lint && npm run typecheck"
    },
    "devDependencies": {
        "husky": "^9.1.7",
        "lint-staged": "^16.4.0",
        "prettier": "^3.9.6",
        "typescript": "^5.9.2"
    },
    "lint-staged": {
        "**/*.{js,jsx,mjs,cjs,ts,tsx,json,css,md,yml,yaml}": [
            "prettier --write"
        ],
        "apps/api/**/*.{js,jsx,mjs,cjs,ts,tsx}": [
            "eslint --config apps/api/eslint.config.mjs --fix --no-warn-ignored"
        ]
    }
}
