# Credentials for scripts/snapshot-api.sh. Copy to scripts/.env.snapshot and
# fill in. That file is gitignored — these are real logins, never commit them.
#
# The three accounts must already exist in the database you point at, and that
# database needs at least one service listing with a portfolio on it and one
# certificate owned by the provider. See docs/refactor/phase-0-safety-net.md.

API_URL=http://localhost:4000

PROVIDER_EMAIL=
PROVIDER_PASSWORD=

RECEIVER_EMAIL=
RECEIVER_PASSWORD=

ADMIN_EMAIL=
ADMIN_PASSWORD=
