PORT=4000

# Signing key for access tokens. Generate one per environment:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# How long a session lasts, in seconds. One number for both the access token and
# the cookie that carries it — the old JWT_EXPIRES_IN only moved the token, so
# setting it left the cookie expiring at the original hour. Default 3600.
SESSION_TTL_SECONDS=3600

# Supabase connection strings — Project Settings -> Database -> Connection string
# Pooled (Supavisor, transaction mode, port 6543) — used by the app at runtime
# through the Prisma driver adapter (see src/lib/prisma.ts).
DATABASE_URL=

# Direct (port 5432) — used by the Prisma CLI (migrate, db pull, studio).
# PgBouncer's transaction-pooling mode doesn't support what these commands need.
DIRECT_URL=

# URL of the frontend app — used to restrict CORS to a specific origin.
# In production, set this to your deployed frontend URL (e.g. https://yourdomain.com).
# When left unset, the API allows requests from any origin (fine for local development).
FRONTEND_URL=
# File storage (Supabase Storage) - paste the project URL & secret API key.
# Needs four public buckets, one per kind of upload: `certificate`, `portfolio`,
# `profile` and `quotation`. See apps/api/README.md -> File storage.
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# development or production. Only production makes the session cookie Secure,
# so leave it unset locally or the cookie will not survive plain http.
NODE_ENV=development

# Only `npm run db:seed` reads this: the password the snapshot_ accounts get.
# Unset means snapshot-dev-password. Put the same value in scripts/.env.snapshot.
SEED_PASSWORD=

# Only src/create-admin.ts reads these: the admin account it creates or
# resets on a deployed database, where db:seed refuses to run.
ADMIN_EMAIL=
ADMIN_PASSWORD=
