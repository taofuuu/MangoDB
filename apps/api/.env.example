PORT=4000

# Signing key for access tokens. Generate one per environment:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=1h

# Supabase connection strings — Project Settings -> Database -> Connection string
# Pooled (Supavisor, transaction mode, port 6543) — used by the app at runtime
# through the Prisma driver adapter (see src/lib/prisma.ts).
DATABASE_URL=

# Direct (port 5432) — used by the Prisma CLI (migrate, db pull, studio).
# PgBouncer's transaction-pooling mode doesn't support what these commands need.
DIRECT_URL=
