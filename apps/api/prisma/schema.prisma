generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  moduleFormat    = "cjs"
  // Lets @@unique take a `where`, for the one-PENDING rules on proposal and
  // quotation. Without it the index lives only in SQL and the next
  // `migrate diff` would try to drop it.
  previewFeatures = ["partialIndexes"]
}

datasource db {
  provider = "postgresql"
}

// Models are PascalCase and fields are camelCase, with @map / @@map carrying
// the real snake_case table and column names. See docs/conventions.md section 1:
// snake_case stops at the database, and this file is where it stops.
//
// @map changes no database column. It only changes what Prisma calls one, so
// nothing here needs a migration and `prisma migrate diff` reports no drift.
// `npm run db:pull` preserves these renames, so re-introspecting is safe.

model Category {
  categoryId      Int               @id @default(autoincrement()) @map("cat_id")
  categoryName    String            @unique @map("cat_name") @db.VarChar(100)
  listingCategory ListingCategory[]

  @@map("category")
}

model Certificate {
  providerId    Int      @map("provider_id")
  certTitle     String   @map("cert_title") @db.VarChar(255)
  certImage     String?  @map("cert_image") @db.VarChar(255)
  certificateId Int      @id @default(autoincrement()) @map("certificate_id")
  credentialId  String?  @map("credential_id") @db.VarChar(255)
  credentialUrl String?  @map("credential_url") @db.VarChar(255)
  expireMonth   Int?     @map("expire_month")
  expireYear    Int?     @map("expire_year")
  issueMonth    Int?     @map("issue_month")
  issueYear     Int?     @map("issue_year")
  organization  String   @db.VarChar(255)
  provider      Provider @relation(fields: [providerId], references: [companyId], onDelete: Cascade, onUpdate: NoAction)

  @@index([providerId])
  @@map("certificate")
}

model Company {
  companyId          Int           @id @default(autoincrement()) @map("company_id")
  companyName        String        @map("company_name") @db.VarChar(255)
  companyDescription String?       @map("company_description")
  username           String        @unique @db.VarChar(50)
  password           String        @db.VarChar(255)
  email              String        @unique @db.VarChar(100)
  phone              String        @db.VarChar(20)
  address            String?
  website            String?       @db.VarChar(255)
  accountType        String        @map("account_type") @db.VarChar(100)
  contactEmail       String?       @map("contact_email") @db.VarChar(100)
  // Public URL of the photo in the `profile` storage bucket. Null until the
  // company uploads one. Same shape as certImage and portfolioImage: the
  // bytes live in storage, the column only points at them.
  companyPhoto       String?       @map("company_photo") @db.VarChar(255)
  // Soft delete. Null means active; a timestamp means the account is gone as
  // far as discovery is concerned, while everything it is attached to -
  // listings, proposals, projects, reviews - stays exactly where it is.
  //
  // The rule this creates: discovery queries (company search, browse, find a
  // provider) filter on deletedAt; history queries (past projects, reviews)
  // must NOT, or they hide the very history this column exists to keep.
  deletedAt          DateTime?     @map("deleted_at") @db.Timestamptz(6)
  // When the company accepted the Terms of Service at registration. Nullable
  // because accounts created before the ToS existed never accepted it; new
  // registrations set it (T1.13.5).
  tosAcceptedAt      DateTime?     @map("tos_accepted_at") @db.Timestamptz(6)
  companyType        CompanyType[]
  listing            Listing[]
  proposal           Proposal[]
  provider           Provider?
  receiver           Receiver?

  @@index([deletedAt])
  @@map("company")
}

model CompanyType {
  companyId   Int     @map("company_id")
  companyType String  @map("company_type") @db.VarChar(100)
  company     Company @relation(fields: [companyId], references: [companyId], onDelete: Cascade, onUpdate: NoAction)

  @@id([companyId, companyType])
  @@map("company_type")
}

model Job {
  listingId    Int       @id @map("listing_id")
  locationPref String?   @map("location_pref") @db.VarChar(100)
  duration     String?   @db.VarChar(100)
  deadline     DateTime? @db.Date
  listing      Listing   @relation(fields: [listingId], references: [listingId], onDelete: Cascade, onUpdate: NoAction)

  @@map("job_requirement")
}

model Listing {
  listingId       Int               @id @default(autoincrement()) @map("listing_id")
  companyId       Int?              @map("company_id")
  listingTitle    String            @map("listing_title") @db.VarChar(255)
  listingDesc     String            @map("listing_desc")
  minBudget       Int?              @map("min_budget")
  maxBudget       Int?              @map("max_budget")
  listingStatus   String            @map("listing_status") @db.VarChar(50)
  listingType     String            @map("listing_type") @db.VarChar(20)
  createdAt       DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  job             Job?
  company         Company?          @relation(fields: [companyId], references: [companyId], onDelete: Cascade, onUpdate: NoAction)
  listingCategory ListingCategory[]
  proposal        Proposal[]
  service         Service?

  @@map("listing")
}

model ListingCategory {
  listingId  Int      @map("listing_id")
  categoryId Int      @map("cat_id")
  category   Category @relation(fields: [categoryId], references: [categoryId], onDelete: Cascade, onUpdate: NoAction)
  listing    Listing  @relation(fields: [listingId], references: [listingId], onDelete: Cascade, onUpdate: NoAction)

  @@id([listingId, categoryId])
  @@map("listing_category")
}

model Project {
  projectId          Int               @id @default(autoincrement()) @map("proj_id")
  proposalId         Int               @unique @map("proposal_id")
  totalBudget        Decimal           @map("total_budget") @db.Decimal(12, 2)
  startDate          DateTime          @map("start_date") @db.Date
  endDate            DateTime?         @map("end_date") @db.Date
  comment            String?
  // ADR 0015: one of PROJECT_STATUSES in packages/shared.
  projectStatus      String            @map("status") @db.VarChar(50)
  // US4-6 and US4-7. Null until the Receiver reports the deposit, then until
  // the Provider confirms it.
  depositReportedAt  DateTime?         @map("deposit_reported_at") @db.Timestamptz(6)
  depositConfirmedAt DateTime?         @map("deposit_confirmed_at") @db.Timestamptz(6)
  // US4-13. Set when the Receiver accepts the work.
  completedAt        DateTime?         @map("completed_at") @db.Timestamptz(6)
  proposal           Proposal          @relation(fields: [proposalId], references: [proposalId], onDelete: Restrict, onUpdate: NoAction)
  projectContract    ProjectContract[]
  projectUpdate      ProjectUpdate[]
  quotation          Quotation[]
  review             Review?

  @@map("project")
}

// ADR 0017. A PDF the Provider sends on a project. Only one may be PENDING
// at a time; decided ones stay as the record of what was agreed.
model Quotation {
  quotationId     Int      @id @default(autoincrement()) @map("quotation_id")
  projectId       Int      @map("proj_id")
  // Public URL of the PDF in storage, like certImage and portfolioImage.
  quotationFile   String   @map("quotation_file") @db.VarChar(255)
  quotationStatus String   @map("quotation_status") @db.VarChar(50)
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  project         Project  @relation(fields: [projectId], references: [projectId], onDelete: Cascade, onUpdate: NoAction)

  @@unique([projectId], where: raw("quotation_status = 'PENDING'"))
  @@index([projectId])
  @@map("quotation")
}

// US4-10 and US4-12. A project's timeline: the Provider's progress notes and
// the Receiver's reasons for rejecting the work. Append-only: a correction is
// a new row.
model ProjectUpdate {
  projectUpdateId Int      @id @default(autoincrement()) @map("project_update_id")
  projectId       Int      @map("proj_id")
  updateType      String   @map("update_type") @db.VarChar(50)
  updateText      String   @map("update_text")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  project         Project  @relation(fields: [projectId], references: [projectId], onDelete: Cascade, onUpdate: NoAction)

  @@index([projectId])
  @@map("project_update")
}

// ADR 0018. One per project, by its Receiver, once COMPLETED. Final: no edit
// or delete. Each score is 1 to 5; Zod enforces it, like the status columns.
model Review {
  reviewId           Int      @id @default(autoincrement()) @map("review_id")
  projectId          Int      @unique @map("proj_id")
  workQualityScore   Int      @map("work_quality_score")
  // How the Provider dealt with the Receiver, not a service listing.
  serviceScore       Int      @map("service_score")
  valueForMoneyScore Int      @map("value_for_money_score")
  deliveryTimeScore  Int      @map("delivery_time_score")
  comment            String?  @db.VarChar(500)
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  project            Project  @relation(fields: [projectId], references: [projectId], onDelete: Cascade, onUpdate: NoAction)

  @@map("review")
}

model ProjectContract {
  projectId    Int     @map("proj_id")
  documentLink String  @map("document_link") @db.VarChar(255)
  project      Project @relation(fields: [projectId], references: [projectId], onDelete: Cascade, onUpdate: NoAction)

  @@id([projectId, documentLink])
  @@map("project_contract")
}

model Proposal {
  proposalId     Int      @id @default(autoincrement()) @map("proposal_id")
  listingId      Int      @map("listing_id")
  senderId       Int      @map("sender_id")
  proposalBudget Decimal  @map("proposal_budget") @db.Decimal(12, 2)
  proposalTerms  String   @map("proposal_terms")
  duration       Decimal  @db.Decimal(4, 1)
  proposalStatus String   @map("proposal_status") @db.VarChar(50)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  project        Project?
  listing        Listing  @relation(fields: [listingId], references: [listingId], onDelete: Cascade, onUpdate: NoAction)
  sender         Company  @relation(fields: [senderId], references: [companyId], onDelete: Cascade, onUpdate: NoAction)

  // ADR 0016. One PENDING proposal per sender per listing. Once it is decided
  // the same company may send another.
  @@unique([listingId, senderId], where: raw("proposal_status = 'PENDING'"))
  @@map("proposal")
}

model Provider {
  companyId      Int           @id @map("company_id")
  warrantyPolicy String?       @map("warranty_policy")
  serviceTerm    String?       @map("service_term")
  certificate    Certificate[]
  company        Company       @relation(fields: [companyId], references: [companyId], onDelete: Cascade, onUpdate: NoAction)

  @@map("provider")
}

model Receiver {
  companyId Int     @id @map("company_id")
  company   Company @relation(fields: [companyId], references: [companyId], onDelete: Cascade, onUpdate: NoAction)

  @@map("receiver")
}

model Service {
  listingId        Int                @id @map("listing_id")
  listing          Listing            @relation(fields: [listingId], references: [listingId], onDelete: Cascade, onUpdate: NoAction)
  servicePortfolio ServicePortfolio[]
  serviceTechStack ServiceTechStack[]

  @@map("service")
}

// ADR 0009. A service's tech stack, linked like listing_category: one row per
// service and tech. Points at service, so a job can never carry one.
model ServiceTechStack {
  listingId   Int       @map("listing_id")
  techStackId Int       @map("tech_stack_id")
  service     Service   @relation(fields: [listingId], references: [listingId], onDelete: Cascade, onUpdate: NoAction)
  techStack   TechStack @relation(fields: [techStackId], references: [techStackId], onDelete: Cascade, onUpdate: NoAction)

  @@id([listingId, techStackId])
  @@map("service_tech_stack")
}

// ADR 0009. Every tech name any service has used. Unlike category this list
// is open: a new name is added the first time a service sends it.
model TechStack {
  techStackId      Int                @id @default(autoincrement()) @map("tech_stack_id")
  techStackName    String             @unique @map("tech_stack_name") @db.VarChar(100)
  serviceTechStack ServiceTechStack[]

  @@map("tech_stack")
}

model ServicePortfolio {
  listingId            Int      @map("listing_id")
  portfolioLink        String   @map("portfolio_link") @db.VarChar(255)
  portfolioId          Int      @id @default(autoincrement()) @map("portfolio_id")
  developmentDate      DateTime @map("development_date") @db.Date
  portfolioDescription String?  @map("portfolio_description")
  portfolioImage       String   @map("portfolio_image") @db.VarChar(255)
  portfolioName        String   @map("portfolio_name") @db.VarChar(255)
  service              Service  @relation(fields: [listingId], references: [listingId], onDelete: Cascade, onUpdate: NoAction)

  @@unique([listingId, portfolioLink])
  @@map("service_portfolio")
}

model RevokedToken {
  jti       String   @id @db.VarChar(64)
  expiresAt DateTime @map("expires_at") @db.Timestamptz(6)

  @@index([expiresAt])
  @@map("revoked_token")
}
