generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

// Models are PascalCase and fields are camelCase, with @map / @@map carrying
// the real snake_case table and column names. See docs/conventions.md section 1:
// snake_case stops at the database, and this file is where it stops.
//
// @map changes no database column. It only changes what Prisma calls one, so
// nothing here needs a migration and `prisma migrate diff` reports no drift.
// `npm run db:pull` preserves these renames, so re-introspecting is safe.

model Category {
  catId           Int               @id @default(autoincrement()) @map("cat_id")
  catName         String            @unique @map("cat_name") @db.VarChar(100)
  listingCategory ListingCategory[]

  @@map("category")
}

model Certificate {
  providerId    Int      @map("provider_id")
  certTitle     String   @map("cert_title") @db.VarChar(255)
  certImage     String?  @map("cert_image") @db.VarChar(255)
  certificateId Int      @id @default(autoincrement()) @map("certificate_id")
  credentialId  String?  @map("credential_id") @db.VarChar(255)
  credentialUrl String?  @map("credential_url") @db.VarChar(255)
  expireMonth   Int?     @map("expire_month")
  expireYear    Int?     @map("expire_year")
  issueMonth    Int?     @map("issue_month")
  issueYear     Int?     @map("issue_year")
  organization  String   @db.VarChar(255)
  provider      Provider @relation(fields: [providerId], references: [companyId], onDelete: Cascade, onUpdate: NoAction)

  @@index([providerId])
  @@map("certificate")
}

model Company {
  companyId          Int           @id @default(autoincrement()) @map("company_id")
  companyName        String        @map("company_name") @db.VarChar(255)
  companyDescription String?       @map("company_description")
  username           String        @unique @db.VarChar(50)
  password           String        @db.VarChar(255)
  email              String        @unique @db.VarChar(100)
  phone              String        @db.VarChar(20)
  address            String?
  website            String?       @db.VarChar(255)
  accountType        String        @map("account_type") @db.VarChar(100)
  contactEmail       String?       @map("contact_email") @db.VarChar(100)
  // Soft delete. Null means active; a timestamp means the account is gone as
  // far as discovery is concerned, while everything it is attached to -
  // listings, proposals, projects, reviews - stays exactly where it is.
  //
  // The rule this creates: discovery queries (company search, browse, find a
  // provider) filter on deletedAt; history queries (past projects, reviews)
  // must NOT, or they hide the very history this column exists to keep.
  deletedAt          DateTime?     @map("deleted_at") @db.Timestamptz(6)
  companyType        CompanyType[]
  listing            Listing[]
  proposal           Proposal[]
  provider           Provider?
  receiver           Receiver?

  @@index([deletedAt])
  @@map("company")
}

model CompanyType {
  companyId   Int     @map("company_id")
  companyType String  @map("company_type") @db.VarChar(100)
  company     Company @relation(fields: [companyId], references: [companyId], onDelete: Cascade, onUpdate: NoAction)

  @@id([companyId, companyType])
  @@map("company_type")
}

model JobRequirement {
  listingId    Int       @id @map("listing_id")
  locationPref String?   @map("location_pref") @db.VarChar(100)
  duration     String?   @db.VarChar(100)
  deadline     DateTime? @db.Date
  listing      Listing   @relation(fields: [listingId], references: [listingId], onDelete: Cascade, onUpdate: NoAction)

  @@map("job_requirement")
}

model Listing {
  listingId       Int               @id @default(autoincrement()) @map("listing_id")
  companyId       Int?              @map("company_id")
  listingTitle    String            @map("listing_title") @db.VarChar(255)
  listingDesc     String            @map("listing_desc")
  minBudget       Int?              @map("min_budget")
  maxBudget       Int               @map("max_budget")
  listingStatus   String            @map("listing_status") @db.VarChar(50)
  jobRequirement  JobRequirement?
  company         Company?          @relation(fields: [companyId], references: [companyId], onDelete: Cascade, onUpdate: NoAction)
  listingCategory ListingCategory[]
  proposal        Proposal[]
  service         Service?

  @@map("listing")
}

model ListingCategory {
  listingId Int      @map("listing_id")
  catId     Int      @map("cat_id")
  category  Category @relation(fields: [catId], references: [catId], onDelete: Cascade, onUpdate: NoAction)
  listing   Listing  @relation(fields: [listingId], references: [listingId], onDelete: Cascade, onUpdate: NoAction)

  @@id([listingId, catId])
  @@map("listing_category")
}

model Project {
  projId          Int               @id @default(autoincrement()) @map("proj_id")
  proposalId      Int?              @unique @map("proposal_id")
  totalBudget     Decimal           @map("total_budget") @db.Decimal(12, 2)
  startDate       DateTime          @map("start_date") @db.Date
  endDate         DateTime?         @map("end_date") @db.Date
  comment         String?
  status          String            @db.VarChar(50)
  proposal        Proposal?         @relation(fields: [proposalId], references: [proposalId], onDelete: Restrict, onUpdate: NoAction)
  projectContract ProjectContract[]
  rating          Rating[]

  @@map("project")
}

model ProjectContract {
  projId       Int     @map("proj_id")
  documentLink String  @map("document_link") @db.VarChar(255)
  project      Project @relation(fields: [projId], references: [projId], onDelete: Cascade, onUpdate: NoAction)

  @@id([projId, documentLink])
  @@map("project_contract")
}

model Proposal {
  proposalId     Int      @id @default(autoincrement()) @map("proposal_id")
  listingId      Int?     @map("listing_id")
  senderId       Int?     @map("sender_id")
  proposalBudget Decimal  @map("proposal_budget") @db.Decimal(12, 2)
  proposalTerms  String   @map("proposal_terms")
  proposalStatus String   @map("proposal_status") @db.VarChar(50)
  project        Project?
  listing        Listing? @relation(fields: [listingId], references: [listingId], onDelete: Cascade, onUpdate: NoAction)
  company        Company? @relation(fields: [senderId], references: [companyId], onDelete: Cascade, onUpdate: NoAction)

  @@map("proposal")
}

model Provider {
  companyId         Int                 @id @map("company_id")
  warrantyPolicy    String?             @map("warranty_policy")
  serviceTerm       String?             @map("service_term")
  certificate       Certificate[]
  company           Company             @relation(fields: [companyId], references: [companyId], onDelete: Cascade, onUpdate: NoAction)
  providerTechStack ProviderTechStack[]

  @@map("provider")
}

model ProviderTechStack {
  companyId     Int      @map("company_id")
  techStackName String   @map("tech_stack_name") @db.VarChar(100)
  provider      Provider @relation(fields: [companyId], references: [companyId], onDelete: Cascade, onUpdate: NoAction)

  @@id([companyId, techStackName])
  @@map("provider_tech_stack")
}

model Rating {
  ratingId    Int      @id @default(autoincrement()) @map("rating_id")
  ratingTitle String   @map("rating_title") @db.VarChar(100)
  ratingScore Decimal  @map("rating_score") @db.Decimal(2, 1)
  projId      Int?     @map("proj_id")
  project     Project? @relation(fields: [projId], references: [projId], onDelete: Cascade, onUpdate: NoAction)

  @@map("rating")
}

model Receiver {
  companyId Int     @id @map("company_id")
  company   Company @relation(fields: [companyId], references: [companyId], onDelete: Cascade, onUpdate: NoAction)

  @@map("receiver")
}

model Service {
  listingId        Int                @id @map("listing_id")
  listing          Listing            @relation(fields: [listingId], references: [listingId], onDelete: Cascade, onUpdate: NoAction)
  servicePortfolio ServicePortfolio[]

  @@map("service")
}

model ServicePortfolio {
  listingId            Int      @map("listing_id")
  portfolioLink        String   @map("portfolio_link") @db.VarChar(255)
  portfolioId          Int      @id @default(autoincrement()) @map("portfolio_id")
  developmentDate      DateTime @map("development_date") @db.Date
  portfolioDescription String?  @map("portfolio_description")
  portfolioImage       String   @map("portfolio_image") @db.VarChar(255)
  portfolioName        String   @map("portfolio_name") @db.VarChar(255)
  service              Service  @relation(fields: [listingId], references: [listingId], onDelete: Cascade, onUpdate: NoAction)

  @@unique([listingId, portfolioLink])
  @@map("service_portfolio")
}

model RevokedToken {
  jti       String   @id @db.VarChar(64)
  expiresAt DateTime @map("expires_at") @db.Timestamptz(6)

  @@index([expiresAt])
  @@map("revoked_token")
}
