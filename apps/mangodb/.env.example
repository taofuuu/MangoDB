# Where the API lives. next.config.ts rewrites /api/* here, so the browser only
# ever talks to this Next server and every request is same-origin — which is
# what lets the session cookie work with no CORS involved.
#
# Not NEXT_PUBLIC_*: only the Next server reads this, and a public variable is
# baked into the browser bundle, where the API's address does not belong.
API_URL=http://localhost:4000
